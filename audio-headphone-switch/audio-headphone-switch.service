[Unit]
Description=Switch onboard audio between 5.1 and headphones on jack plug/unplug
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/audio-headphone-switch
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
