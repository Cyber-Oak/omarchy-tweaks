#!/bin/bash
# Notify about pending pacman/AUR updates at most once per 24h.
# Triggered hourly + 1min after boot by update-check-notify.timer;
# skips unless 24h have passed since the last successful check.

stamp="${XDG_STATE_HOME:-$HOME/.local/state}/update-check-notify.last"
interval=$((24 * 60 * 60))

if [[ $1 != --force && -f $stamp ]]; then
  last=$(<"$stamp")
  (( $(date +%s) - last < interval )) && exit 0
fi

# checkupdates: 0 = updates, 2 = none, anything else = error (e.g. no network yet)
repo=$(checkupdates --nocolor 2>/dev/null)
rc=$?
(( rc != 0 && rc != 2 )) && exit 1  # don't stamp, retry next hour

aur=""
if pacman -Qqm >/dev/null 2>&1; then
  aur=$(timeout 60 yay -Qua 2>/dev/null)
fi

date +%s > "$stamp"

repo_n=$(grep -c . <<<"$repo")
aur_n=$(grep -c . <<<"$aur")
total=$((repo_n + aur_n))
(( total == 0 )) && exit 0

body="$repo_n repo"
(( aur_n > 0 )) && body+=", $aur_n AUR"
body+=" package update(s) available"

action=$(notify-send -a "System Update" -i system-software-update -u critical \
  -A default="Update now" "Updates available ($total)" "$body")

if [[ $action == default ]]; then
  omarchy-launch-floating-terminal-with-presentation omarchy-update
fi
